<?xml version="1.0" encoding="UTF-8"?>
<StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.1.0/StyledLayerDescriptor.xsd" xmlns:se="http://www.opengis.net/se">
  <NamedLayer>
    <se:Name>Climat</se:Name>
    <UserStyle>
      <se:Name>Climat</se:Name>
      <se:FeatureTypeStyle>
        <se:Rule>
          <se:Name>Arid continental, with dry warm summersand moderate cold winters</se:Name>
          <se:Description>
            <se:Title>Arid continental, with dry warm summersand moderate cold winters</se:Title>
          </se:Description>
          <ogc:Filter xmlns:ogc="http://www.opengis.net/ogc">
            <ogc:PropertyIsEqualTo>
              <ogc:PropertyName>Descriptio</ogc:PropertyName>
              <ogc:Literal>Arid continental, with dry warm summersand moderate cold winters</ogc:Literal>
            </ogc:PropertyIsEqualTo>
          </ogc:Filter>
          <se:PolygonSymbolizer>
            <se:Fill>
              <se:SvgParameter name="fill">#d7191c</se:SvgParameter>
            </se:Fill>
          </se:PolygonSymbolizer>
        </se:Rule>
        <se:Rule>
          <se:Name>Arid subtropical, with hot summers and calm winters</se:Name>
          <se:Description>
            <se:Title>Arid subtropical, with hot summers and calm winters</se:Title>
          </se:Description>
