              <se:SvgParameter name="fill">#febe4e</se:SvgParameter>
            </se:Fill>
          </se:PolygonSymbolizer>
        </se:Rule>
        <se:Rule>
          <se:Name>Moderate, relativly humid during all seasons</se:Name>
