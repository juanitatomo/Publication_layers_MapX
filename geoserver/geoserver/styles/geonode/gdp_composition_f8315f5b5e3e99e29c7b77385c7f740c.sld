              <ogc:PropertyIsLessThanOrEqualTo>
                <ogc:PropertyName>inustry</ogc:PropertyName>
                <ogc:Literal>0.5</ogc:Literal>
              </ogc:PropertyIsLessThanOrEqualTo>
